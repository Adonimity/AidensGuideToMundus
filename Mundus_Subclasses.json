        {
            "name": "Resilience of the Dunes",
            "source": "AGtM",
            "className": "Barbarian",
            "classSource": "XPHB",
            "subclassShortName": "Dune Wanderer",
            "subclassSource": "AGtM",
            "level": 3,
            "header": 1,
            "entries": [
                "You have learned to survive on the worst of conditions. You only ever need to consume food and water for a tiny sized creature no matter your size."
            ]
        },
        {
            "name": "Rage of the Desert Storm",
            "source": "AGtM",
            "className": "Barbarian",
            "classSource": "XPHB",
            "subclassShortName": "Dune Wanderer",
            "subclassSource": "AGtM",
            "level": 3,
            "header": 1,
            "entries": [
                "While your rage is active you gain a blindsight up to 30 feet. A sandstorm gathers around you any creature within a 30 feet emanation from you must succeed a con save DC 8 + prof + con mod and on a fail is {@condition blinded}."
            ]
        },
        {
            "name": "Shifting Sands",
